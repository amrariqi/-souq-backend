# انسخ هذا الملف باسم .env وضع فيه قيمك الحقيقية
# لا تشارك ملف .env مع أحد ولا ترفعه على GitHub أبداً

NOWPAYMENTS_API_KEY=ضع_مفتاح_الـ_API_هنا
NOWPAYMENTS_IPN_SECRET=ضع_مفتاح_IPN_السري_هنا

# رابط سيرفرك بعد رفعه أونلاين (مثال بعد النشر على Render):
# PUBLIC_URL=https://your-app-name.onrender.com
PUBLIC_URL=http://localhost:3000

PORT=3000
